# Addressables build output. The catalog and bundles are published to the gh-pages branch instead;
# addressables_content_state.bin under Assets/ is tracked on purpose, since content updates need it.
ServerData/

# Regenerated by every content build.
Assets/AddressableAssetsData/link.xml
Assets/AddressableAssetsData/link.xml.meta

# The test runner leaves these behind when a play mode run is interrupted.
Assets/InitTestScene*.unity
Assets/InitTestScene*.unity.meta

# Player builds
Builds/

# Generated IDE / solution files
.vs/
.idea/
.vscode/
